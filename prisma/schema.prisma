generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  role           String   @default("FARMER") // ADMIN or FARMER
  phone          String?
  wilaya         String?
  areaHectares   Float?
  productionType String?
  frozen         Boolean  @default(false) // Account freeze/suspend
  frozenReason   String?  // Reason for freezing
  frozenAt       DateTime? // When account was frozen
  lastLoginAt    DateTime? // Last login timestamp
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  farm           Farm?
}

model Farm {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  areaHectares Float
  locationWilaya String
  contractRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasons     Season[]
  inventories Inventory[]
  reports     Report[]
}

model Season {
  id         String   @id @default(cuid())
  farmId     String
  seasonType String   // autumn or spring
  year       Int
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  farm       Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  inventories Inventory[]
  reports     Report[]
}

model Category {
  id        String @id @default(cuid())
  type      String // income or expense
  nameAr    String
  icon      String
  color     String
  sortOrder Int
  transactions Transaction[]
}

model Transaction {
  id                String   @id @default(cuid())
  seasonId          String
  type              String   // income or expense
  categoryId        String?
  amount            Float
  quantity          Float    @default(0)   // quantity sold/purchased
  unitPrice         Float    @default(0)   // price per unit
  linkedInventoryId String?               // links to inventory item for auto-deduction
  txnDate           DateTime
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  season            Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  category          Category? @relation(fields: [categoryId], references: [id])
}

model Inventory {
  id              String    @id @default(cuid())
  farmId          String
  seasonId        String
  itemType        String    // input, crop, animal_product, equipment (معدات), feed (أعلاف), medication (أدوية بيطرية)
  subCategory     String?   // detailed classification (e.g., for input: "بذور"/"أسمدة"/"مبيدات"/"أعلاف"/"مستلزمات", for crop: "حبوب"/"خضروات"/"فواكه"/"بقوليات"/"زيوت", for animal_product: "ألبان"/"بيض"/"لحوم"/"صوف")
  itemName        String
  unit            String
  qtyIn           Float     @default(0)
  qtyOut          Float     @default(0)
  qtyBalance      Float     @default(0)
  unitCost        Float     @default(0)   // purchase price per unit
  alertThreshold  Float     @default(0)
  supplier        String?   // supplier/source name
  expiryDate      DateTime? // for inputs that expire
  storageLocation String?   // where it's stored (e.g., "المخزن الرئيسي", "السقيفة", "الإسطبل")
  description     String?   // additional notes
  batchNumber     String?   // batch/lot number for tracking
  minimumStock    Float     @default(0)   // minimum stock level before reorder
  reorderQuantity Float     @default(0)   // suggested quantity to reorder
  unitPrice       Float     @default(0)   // selling price per unit (different from unitCost which is purchase price)
  lastRestocked   DateTime? // date of last restocking
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  farm            Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  season          Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

model Report {
  id          String   @id @default(cuid())
  farmId      String
  seasonId    String
  reportType  String   // seasonal_account, profitability, compliance, financial_certificate
  generatedAt DateTime @default(now())
  data        String   // JSON string with report data
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}
